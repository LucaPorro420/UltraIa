### 🧠 PASO 6: Actualización del Núcleo NASA para Generación Visual

Ahora, actualiza tu `nucleo_nasa.py`. El objetivo cambia a uno visual, y el Programador usará el cliente que acabamos de crear.

```python
import os
import time
import subprocess
from typing import TypedDict, Literal
from langgraph.graph import StateGraph
from langchain_openai import ChatOpenAI
from langchain_qdrant import Qdrant
from qdrant_client import QdrantClient
from langchain_core.documents import Document
from dotenv import load_dotenv

load_dotenv()

# 1. ESTADO DEL SISTEMA (Adaptado para visión)
class AgentState(TypedDict):
    objetivo_visual: str      # Ej: "Un paisaje cyberpunk con neón rojo"
    plan_investigacion: str
    codigo_generado: str
    resultado_ejecucion: dict
    metricas_evaluacion: dict
    leccion_aprendida: str
    intentos: int
    feedback_evaluador: str
    estado_final: Literal["aprobado", "rechazado", "max_intentos"]

llm = ChatOpenAI(model=os.getenv("LLM_MODEL", "gpt-4o"), temperature=0.2)
qdrant_client = QdrantClient(url="http://localhost:6333")
try: qdrant_client.create_collection(collection_name="memoria_experiencial", vectors_config={"size": 1536, "distance": "Cosine"})
except Exception: pass
vector_store = Qdrant(client=qdrant_client, collection_name="memoria_experiencial", embedding=llm.embeddings)

# ==========================================
# 2. NODOS (LOS AGENTES)
# ==========================================

def investigador(state: AgentState):
    intentos = state.get("intentos", 0)
    print(f"\n🔍 [INVESTIGADOR] Analizando objetivo visual (Intento #{intentos + 1})...")
    
    feedback = state.get("feedback_evaluador", "")
    contexto_feedback = f"⚠️ ERROR ANTERIOR: {feedback}" if feedback else "Primer intento."
    
    prompt = f"""
    OBJETIVO VISUAL: {state['objetivo_visual']}
    {contexto_feedback}
    
    TAREA: Diseña un prompt detallado y técnico para ComfyUI (Stable Diffusion) que logre este objetivo. 
    Incluye palabras clave de iluminación, estilo y calidad. Si hay un error anterior, corrígelo en el prompt.
    Devuelve SOLO el prompt optimizado, sin texto adicional.
    """
    response = llm.invoke(prompt)
    return {"plan_investigacion": response.content.strip(), "intentos": intentos + 1}

def programador(state: AgentState):
    print("💻 [PROGRAMADOR] Creando script de generación usando el cliente ComfyUI...")
    
    # Le damos al LLM el contexto de cómo usar nuestra herramienta auxiliar
    prompt = f"""
    Escribe un script de Python que importe el módulo local 'comfyui_client' y genere una imagen.
    
    PROMPT POSITIVO A USAR: "{state['plan_investigacion']}"
    PROMPT NEGATIVO A USAR: "ugly, blurry, low quality, deformed"
    
    El script debe:
    1. Llamar a `comfyui_client.generate_image('workflow_base.json', 'resultado_sacd.png', positive_prompt, negative_prompt)`
    2. Imprimir "GENERACION EXITOSA" si devuelve True, o "GENERACION FALLIDA" si devuelve False.
    
    NO incluyas markdown, solo código Python puro.
    """
    response = llm.invoke(prompt)
    codigo_limpio = response.content.replace("```python", "").replace("```", "").strip()
    return {"codigo_generado": codigo_limpio}

def ejecutor(state: AgentState):
    print("⚙️ [EJECUTOR] Ejecutando script de generación visual (Timeout: 120s para renderizado)...")
    codigo = state["codigo_generado"]
    archivo_temp = "temp_visual_script.py"
    
    with open(archivo_temp, "w", encoding="utf-8") as f:
        f.write(codigo)
    
    inicio = time.time()
    try:
        # Aumentamos el timeout a 120s porque generar imágenes con IA tarda más que un script de texto
        resultado = subprocess.run(
            ["python", archivo_temp],
            capture_output=True, text=True, timeout=120, encoding="utf-8"
        )
        tiempo = time.time() - inicio
        
        return {
            "resultado_ejecucion": {
                "exito": resultado.returncode == 0 and "GENERACION EXITOSA" in resultado.stdout,
                "stdout": resultado.stdout.strip(),
                "stderr": resultado.stderr.strip(),
                "tiempo_segundos": round(tiempo, 2)
            }
        }
    except subprocess.TimeoutExpired:
        return {"resultado_ejecucion": {"exito": False, "stdout": "", "stderr": "Timeout: La generación tardó más de 120 segundos.", "tiempo_segundos": 120.0}}
    except Exception as e:
        return {"resultado_ejecucion": {"exito": False, "stdout": "", "stderr": str(e), "tiempo_segundos": 0.0}}
    finally:
        if os.path.exists(archivo_temp): os.remove(archivo_temp)

def evaluador(state: AgentState):
    print("🛡️ [EVALUADOR] Verificando integridad del archivo de imagen...")
    ejecucion = state.get("resultado_ejecucion", {})
    intentos = state.get("intentos", 1)
    
    # Verificación 1: ¿El script se ejecutó sin errores de Python?
    if not ejecucion.get("exito"):
        feedback = f"Error de ejecución: {ejecucion.get('stderr')}"
        return {"metricas_evaluacion": {"calidad": 0}, "leccion_aprendida": feedback, "feedback_evaluador": feedback, "estado_final": "rechazado"}

    # Verificación 2: ¿El archivo de imagen existe y tiene un tamaño válido?
    if os.path.exists("resultado_sacd.png"):
        tamaño = os.path.getsize("resultado_sacd.png")
        if tamaño > 10000: # Más de 10KB (una imagen real pesa mucho más)
            metricas = {"calidad": 95, "tiempo": ejecucion.get("tiempo_segundos")}
            leccion = f"ÉXITO: Imagen generada para '{state['objetivo_visual']}' en {metricas['tiempo']}s."
            vector_store.add_documents([Document(page_content=leccion)])
            return {"metricas_evaluacion": metricas, "leccion_aprendida": leccion, "feedback_evaluador": "OK", "estado_final": "aprobado"}
        else:
            feedback = "El archivo se creó pero está corrupto o vacío (tamaño < 10KB)."
    else:
        feedback = "El script terminó pero el archivo 'resultado_sacd.png' no se encontró en el directorio."

    return {"metricas_evaluacion": {"calidad": 0}, "leccion_aprendida": feedback, "feedback_evaluador": feedback, "estado_final": "rechazado"}

# ==========================================
# 3. LÓGICA DEL BUCLE Y GRAFO
# ==========================================

def decidir_siguiente_paso(state: AgentState) -> Literal["investigador", "fin_exitoso", "fin_fallido"]:
    estado = state.get("estado_final", "")
    intentos = state.get("intentos", 0)
    if estado == "aprobado": return "fin_exitoso"
    elif intentos >= 3: return "fin_fallido"
    else: return "investigador"

workflow = StateGraph(AgentState)
workflow.add_node("investigador", investigador)
workflow.add_node("programador", programador)
workflow.add_node("ejecutor", ejecutor)
workflow.add_node("evaluador", evaluador)
workflow.add_node("fin_exitoso", lambda s: print("\n✅ [SISTEMA] IMAGEN GENERADA Y VALIDADA CON ÉXITO."))
workflow.add_node("fin_fallido", lambda s: print("\n❌ [SISTEMA] FALLO EN LA GENERACIÓN VISUAL TRAS 3 INTENTOS."))

workflow.set_entry_point("investigador")
workflow.add_edge("investigador", "programador")
workflow.add_edge("programador", "ejecutor")
workflow.add_edge("ejecutor", "evaluador")
workflow.add_conditional_edges("evaluador", decidir_siguiente_paso, {"investigador": "investigador", "fin_exitoso": "fin_exitoso", "fin_fallido": "fin_fallido"})

app = workflow.compile()

# ==========================================
# 4. EJECUCIÓN
# ==========================================
if __name__ == "__main__":
    print("="*60)
    print("INICIANDO CICLO NASA: GENERACIÓN VISUAL AUTÓNOMA")
    print("="*60)
    
    resultado = app.invoke({
        "objetivo_visual": "Un astronauta montando un caballo en Marte, estilo cinematográfico, 8k, iluminación volumétrica",
        "intentos": 0, "estado_final": ""
    })
    
    print("\n" + "="*60)
    print(f"Estado final: {resultado['estado_final'].upper()} | Intentos: {resultado['intentos']}")
    print(f"Lección final: {resultado['leccion_aprendida']}")
```

