{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "pipeline": {
    "language_target": "ar-SA",
    "dialects_supported": ["msa", "egyptian", "gulf", "levantine"],
    "text_generation": {
      "provider": "openai",
      "model": "gpt-4o",
      "temperature": 0.7,
      "response_format": { "type": "json_object" }
    },
    "voice_synthesis": {
      "provider": "elevenlabs",
      "model_id": "eleven_multilingual_v2",
      "arabic_settings": {
        "stability": 0.45,
        "similarity_boost": 0.85,
        "speaker_boost": true
      }
    },
    "video_generation": {
      "provider": "runwayml",
      "model": "gen3a_turbo",
      "duration_sec": 10
    }
  }
}