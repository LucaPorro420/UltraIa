{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIGenerativePipelineConfig",
  "version": "2.0.0",
  "pipeline": {
    "language_target": "ar-SA",
    "dialects_supported": ["msa", "egyptian", "gulf", "levantine"],
    "text_generation": {
      "provider": "openai",
      "model": "gpt-4o",
      "temperature": 0.7,
      "response_format": { "type": "json_object" }
    },
    "voice_synthesis": {
      "provider": "elevenlabs",
      "model_id": "eleven_multilingual_v2",
      "arabic_settings": {
        "stability": 0.45,
        "similarity_boost": 0.85,
        "style_exaggeration": 0.15,
        "speaker_boost": true
      }
    },
    "image_generation": {
      "provider": "pollinations",
      "model": "flux",
      "size": "1024x1792"
    },
    "video_generation": {
      "provider": "runwayml",
      "model": "gen3a_turbo",
      "aspect_ratio": "16:9",
      "duration_sec": 5
    },
    "fal_ai": {
      "image_model": "fal-ai/flux/dev",
      "video_model": "fal-ai/kling-video/v1/standard/text-to-video"
    },
    "polling": {
      "initial_delay_sec": 10,
      "max_delay_sec": 30,
      "max_retries": 20
    }
  }
}
