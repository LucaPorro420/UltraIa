# Copia este archivo a `.env` y completa las claves.
# NUNCA subas .env a git: las claves API se leen SOLO desde variables de entorno.

# --- LLM (generación de guion + prompts visuales) ---
# Proveedor: openai (gpt-4o / gpt-4o-mini). También compatible con endpoints OpenAI-style:
# DeepSeek (https://api.deepseek.com/v1) u Ollama local (http://localhost:11434/v1).
OPENAI_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"

# --- ElevenLabs (voz TTS multilingüe, soporta árabe con diacríticos) ---
ELEVENLABS_API_KEY=""
# Voice ID por defecto (Rachel). Reemplázalo por una voz nativa ar-SA desde tu dashboard.
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# --- Runway (text-to-video / image-to-video) ---
RUNWAY_API_KEY=""

# --- Fal.ai (ALTERNATIVA a Runway: FLUX para imágenes, Kling/Luma para video) ---
# Requiere fal-key-id y fal-key-secret (ver https://fal.ai/dashboard/keys)
FAL_KEY_ID=""
FAL_KEY_SECRET=""

# --- OpenAI Images (imágenes DALL-E 3; alternativa a Fal.ai/FLUX) ---
# Usa OPENAI_API_KEY de arriba.

# --- Control ---
# True: usa Fal.ai en vez de Runway para video. False: Runway (default).
ULTRAIA_VIDEO_PROVIDER="runway"

# --- Publicación YouTube Shorts (RF-12) ---
# client_secret.json: credenciales OAuth2 de Google Cloud (YouTube Data API v3),
# descargadas como "App de escritorio". Colócalo en la carpeta del proyecto.
YOUTUBE_CLIENT_SECRET_FILE="client_secret.json"
YOUTUBE_TOKEN_FILE="token_youtube.json"

# --- Publicación TikTok (RF-12) ---
# Token OAuth de una app de desarrollador con permiso video.publish.
TIKTOK_ACCESS_TOKEN=""
