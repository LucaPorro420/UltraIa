---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Plataforma Total Unificada" description="Aprende programación, construye proyectos, despliega con IA">
  <div class="min-h-screen flex flex-col">
    <!-- Hero Section -->
    <header class="relative overflow-hidden bg-gradient-to-b from-panel/50 to-canvas border-b border-border">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-primary/10 via-transparent to-transparent" />
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-32">
        <div class="text-center animate-fade-in">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20 text-primary mb-6 animate-slide-up">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
            </span>
            <span class="text-sm font-medium">Versión 1.0.0 - Beta Pública</span>
          </div>
          
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-bold tracking-tight mb-6 animate-slide-up" style="animation-delay: 100ms;">
            Plataforma Total
            <br />
            <span class="text-primary">Unificada</span>
          </h1>
          
          <p class="text-lg sm:text-xl text-text-secondary max-w-3xl mx-auto mb-10 animate-slide-up" style="animation-delay: 200ms;">
            La primera plataforma que combina <strong class="text-text-primary">47 cursos completos</strong>, 
            <strong class="text-primary">orquestación multi-agente</strong> y 
            <strong class="text-accent-code">34 proveedores LLM gratuitos</strong> en una sola experiencia.
          </p>
          
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up" style="animation-delay: 300ms;">
            <a href="/dashboard" class="w-full sm:w-auto px-8 py-4 bg-primary text-white rounded-lg font-semibold hover:bg-primary-light transition-colors shadow-lg shadow-primary/25">
              Empezar Gratis
            </a>
            <a href="/docs" class="w-full sm:w-auto px-8 py-4 bg-panel border border-border text-text-primary rounded-lg font-semibold hover:bg-border transition-colors">
              Ver Documentación
            </a>
          </div>
        </div>
        
        <!-- Stats Bar -->
        <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-6 animate-slide-up" style="animation-delay: 400ms;">
          <div class="text-center p-4 bg-panel/50 border border-border/50 rounded-xl">
            <div class="text-3xl sm:text-4xl font-display font-bold text-primary">47</div>
            <div class="text-sm text-text-secondary mt-1">Cursos Completos</div>
          </div>
          <div class="text-center p-4 bg-panel/50 border border-border/50 rounded-xl">
            <div class="text-3xl sm:text-4xl font-display font-bold text-accent-code">34</div>
            <div class="text-sm text-text-secondary mt-1">Proveedores LLM</div>
          </div>
          <div class="text-center p-4 bg-panel/50 border border-border/50 rounded-xl">
            <div class="text-3xl sm:text-4xl font-display font-bold text-accent-text">16</div>
            <div class="text-sm text-text-secondary mt-1">Agentes IA</div>
          </div>
          <div class="text-center p-4 bg-panel/50 border border-border/50 rounded-xl">
            <div class="text-3xl sm:text-4xl font-display font-bold text-accent-video">7.4B</div>
            <div class="text-sm text-text-secondary mt-1">Tokens/Mes Gratis</div>
          </div>
        </div>
      </div>
    </header>

    <!-- Features Section -->
    <section class="py-20 sm:py-28 bg-canvas">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-display font-bold mb-4">Todo lo que necesitas en un solo lugar</h2>
          <p class="text-text-secondary max-w-2xl mx-auto">De principiante a arquitecto: cursos, IDE, agentes, despliegue y comunidad</p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Feature Cards -->
          <FeatureCard 
            icon="graduation-cap"
            title="Academia Interactiva"
            description="47 cursos, 269 lecciones, 538 quizzes con certificación verificable. Aprende con método Pomodoro, rachas y recomendaciones IA."
            features={['Ruta Maestra Full Stack', 'IA/ML Engineering', 'DevOps & Cloud', 'Arquitectura de Software']}
          />
          
          <FeatureCard 
            icon="code"
            title="IDE Educativo Inteligente"
            description="Editor con IA que enseña mientras programas. Explica, visualiza, crea ejercicios, optimiza y debuggea tu código en tiempo real."
            features={['Modo Aprendizaje/Experto', 'Explicación línea por línea', 'Debugging asistido', 'Multi-lenguaje']}
          />
          
          <FeatureCard 
            icon="bot"
            title="Orquestación Multi-Agente"
            description="16 agentes especializados (Tutor, Coder, Architect, Security, etc.) que colaboran para construir tus proyectos completos."
            features={['Orquestador central', 'Memoria compartida', 'Human-in-the-loop', 'MCP Server']}
          />
          
          <FeatureCard 
            icon="cloud"
            title="FreeLLMAPI Gateway"
            description="Acceso unificado a 34 proveedores gratuitos (Google, Groq, OpenRouter, etc.) con 7.4B tokens/mes. Sin keys, sin límites."
            features={['Auto-failover', 'Rate limiting inteligente', 'Fusion multi-modelo', 'OpenAI compatible']}
          />
          
          <FeatureCard 
            icon="database"
            title="Constructor de Proyectos"
            description="De la idea al despliegue: arquitectura, BD, API, frontend, tests, CI/CD, monitoring. Todo generado y explicado."
            features={['Generador autónomo', 'Plantillas por stack', 'Deploy 1-click', 'Monitoreo incluido']}
          />
          
          <FeatureCard 
            icon="puzzle"
            title="Sistema de Plugins"
            description="Extiende la plataforma con lenguajes, frameworks, modelos, herramientas cloud, bases de datos y agentes personalizados."
            features={['Marketplace integrado', 'Sandbox seguro', 'API unificada', 'Versionado semántico']}
          />
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="py-20 sm:py-28 bg-panel/30 border-y border-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-display font-bold mb-4">Cómo funciona</h2>
          <p class="text-text-secondary max-w-2xl mx-auto">Tres modos, una experiencia unificada</p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          <ModeCard 
            number="01"
            title="Aprende"
            description="Elige tu ruta: Full Stack, IA Engineer, DevOps, Arquitectura. La IA adapta el contenido a tu nivel y genera ejercicios personalizados."
            features={['Rutas guiadas', 'Quizzes adaptativos', 'Certificados SHA-256', 'Progreso offline']}
          />
          <ModeCard 
            number="02"
            title="Construye"
            description="Describe tu proyecto y los agentes lo arquitecturan, codifican, testean y documentan. Tú aprendes viendo cómo lo hacen los expertos."
            features={['Orquestación automática', 'Code review IA', 'Tests generados', 'Docs automáticas']}
          />
          <ModeCard 
            number="03"
            title="Despliega"
            description="Deploy a AWS, GCP, Azure, Cloudflare, Vercel. La plataforma configura CI/CD, monitoring, logs y alertas automáticamente."
            features={['Multi-cloud', 'Infra as Code', 'Observabilidad', 'Rollback 1-click']}
          />
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 sm:py-28 bg-canvas">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="bg-gradient-to-r from-primary/10 to-accent-code/10 border border-primary/20 rounded-2xl p-10 sm:p-16">
          <h2 class="text-3xl sm:text-4xl font-display font-bold mb-4">
            ¿Listo para transformar tu carrera?
          </h2>
          <p class="text-text-secondary mb-8 max-w-2xl mx-auto">
            Únete a miles de desarrolladores que ya usan Plataforma Total Unificada. 
            100% gratis para empezar, sin tarjeta de crédito.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/dashboard" class="px-8 py-4 bg-primary text-white rounded-lg font-semibold hover:bg-primary-light transition-colors shadow-lg shadow-primary/25">
              Crear cuenta gratis
            </a>
            <a href="/github" class="px-8 py-4 bg-panel border border-border text-text-primary rounded-lg font-semibold hover:bg-border transition-colors">
              Ver en GitHub
            </a>
          </div>
          <p class="mt-6 text-sm text-text-muted">
            Funciona offline • Sin vendor lock-in • Código abierto • MIT License
          </p>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<!-- Feature Card Component -->
<FeatureCard 
  icon="graduation-cap"
  title="Academia Interactiva"
  description="47 cursos, 269 lecciones, 538 quizzes con certificación verificable. Aprende con método Pomodoro, rachas y recomendaciones IA."
  features={['Ruta Maestra Full Stack', 'IA/ML Engineering', 'DevOps & Cloud', 'Arquitectura de Software']}
/>

<script>
  // Feature Card Component Definition
  class FeatureCard extends HTMLElement {
    connectedCallback() {
      const icon = this.getAttribute('icon') || 'star';
      const title = this.getAttribute('title') || '';
      const description = this.getAttribute('description') || '';
      const features = JSON.parse(this.getAttribute('features') || '[]');
      
      const icons: Record<string, string> = {
        'graduation-cap': '🎓',
        'code': '💻',
        'bot': '🤖',
        'cloud': '☁️',
        'database': '🗄️',
        'puzzle': '🧩',
      };
      
      this.innerHTML = `
        <div class="bg-panel border border-border rounded-2xl p-6 hover:border-primary/50 transition-all duration-300 group">
          <div class="text-4xl mb-4">${icons[icon] || '⭐'}</div>
          <h3 class="text-xl font-display font-bold mb-3">${title}</h3>
          <p class="text-text-secondary mb-4">${description}</p>
          <ul class="space-y-2">
            ${features.map(f => `<li class="flex items-center gap-2 text-sm text-text-secondary group-hover:text-text-primary transition-colors">
              <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
              ${f}
            </li>`).join('')}
          </ul>
        </div>
      `;
    }
  }
  customElements.define('feature-card', FeatureCard);
  
  // Mode Card Component Definition
  class ModeCard extends HTMLElement {
    connectedCallback() {
      const number = this.getAttribute('number') || '01';
      const title = this.getAttribute('title') || '';
      const description = this.getAttribute('description') || '';
      const features = JSON.parse(this.getAttribute('features') || '[]');
      
      this.innerHTML = `
        <div class="relative bg-panel border border-border rounded-2xl p-6 md:p-8">
          <div class="absolute -top-4 left-8 bg-primary text-white text-4xl font-display font-bold w-16 h-16 rounded-full flex items-center justify-center">${number}</div>
          <div class="pt-8">
            <h3 class="text-2xl font-display font-bold mb-4">${title}</h3>
            <p class="text-text-secondary mb-6">${description}</p>
            <ul class="space-y-3">
              ${features.map(f => `<li class="flex items-center gap-3 text-sm">
                <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                ${f}
              </li>`).join('')}
            </ul>
          </div>
        </div>
      `;
    }
  }
  customElements.define('mode-card', ModeCard);
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in { animation: fadeIn 0.6s ease-out forwards; }
  .animate-slide-up { animation: slideUp 0.6s ease-out forwards; opacity: 0; }
</style>