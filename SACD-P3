### 🧠 PASO 3: El Primer Flujo Funcional (Triángulo de Oro)

Vamos a crear el ciclo: **Investigador → Programador → Evaluador → Memoria**.

Crea un archivo llamado `nucleo_nasa.py`:

```python
import os
from typing import TypedDict, Annotated
from langgraph.graph import StateGraph, END
from langchain_openai import ChatOpenAI
from langchain_qdrant import Qdrant
from qdrant_client import QdrantClient
from langchain_core.documents import Document
from dotenv import load_dotenv

load_dotenv()

# 1. Definir el Estado del Sistema (La "Memoria de Trabajo")
class AgentState(TypedDict):
    objetivo: str
    plan_investigacion: str
    codigo_generado: str
    metricas_evaluacion: dict
    leccion_aprendida: str

# Inicializar Modelos y Bases de Datos
llm = ChatOpenAI(model=os.getenv("LLM_MODEL", "gpt-4o"), temperature=0.2)
qdrant_client = QdrantClient(url="http://localhost:6333")
vector_store = Qdrant(client=qdrant_client, collection_name="memoria_experiencial", embedding=llm.embeddings)

# 2. Definir los Nodos (Agentes)
def investigador(state: AgentState):
    print("🔍 [INVESTIGADOR] Analizando el objetivo y buscando en memoria...")
    # Buscar experiencias pasadas similares
    docs = vector_store.similarity_search(state["objetivo"], k=2)
    contexto_pasado = "\n".join([d.page_content for d in docs]) if docs else "Sin experiencias previas."

    prompt = f"Objetivo: {state['objetivo']}. Experiencias pasadas: {contexto_pasado}. Diseña un plan técnico paso a paso."
    response = llm.invoke(prompt)
    return {"plan_investigacion": response.content}

def programador(state: AgentState):
    print("💻 [PROGRAMADOR] Escribiendo el código basado en el plan...")
    prompt = f"Basado en este plan: {state['plan_investigacion']}. Escribe un script de Python funcional (ej. optimización de FFmpeg o script de Blender)."
    response = llm.invoke(prompt)
    return {"codigo_generado": response.content}

def evaluador(state: AgentState):
    print("🛡️ [EVALUADOR] Analizando el código y simulando métricas...")
    prompt = f"Evalúa este código: {state['codigo_generado']}. Asigna puntuaciones (0-100) en: calidad, eficiencia, y probabilidad de error. Devuelve SOLO un JSON."
    response = llm.invoke(prompt)

    # Simulación de extracción de JSON (en producción usarías structured output)
    metricas = {"calidad": 85, "eficiencia": 70, "errores": 2}
    leccion = f"El código es funcional pero la eficiencia es {metricas['eficiencia']}. Sugerencia: Usar procesamiento por lotes."

    # GUARDAR EN MEMORIA EXPERIENCIAL (El paso más importante)
    vector_store.add_documents([
        Document(page_content=f"Problema: {state['objetivo']}. Solución: {leccion}. Métricas: {metricas}")
    ])
    print("💾 [MEMORIA] Lección guardada en Qdrant.")

    return {"metricas_evaluacion": metricas, "leccion_aprendida": leccion}

# 3. Construir el Grafo (La Coordinación)
workflow = StateGraph(AgentState)
workflow.add_node("investigador", investigador)
workflow.add_node("programador", programador)
workflow.add_node("evaluador", evaluador)

workflow.set_entry_point("investigador")
workflow.add_edge("investigador", "programador")
workflow.add_edge("programador", "evaluador")
workflow.add_edge("evaluador", END) # En el futuro, aquí irá un condicional: si score < 80, volver a "investigador"

app = workflow.compile()

# 4. Ejecutar el Sistema
if __name__ == "__main__":
    resultado = app.invoke({"objetivo": "Optimizar la exportación de video 4K a 1080p usando FFmpeg en Python"})
    print("\n✅ RESULTADO FINAL:")
    print(f"Lección Aprendida: {resultado['leccion_aprendida']}")
```

Ejecuta con: `python nucleo_nasa.py`. Verás cómo los agentes "hablan", generan una solución y **la guardan automáticamente en Qdrant**.

