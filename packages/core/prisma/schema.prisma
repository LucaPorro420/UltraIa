generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  name          String?
  passwordHash  String
  role          String             @default("USER") // USER | ADMIN
  createdAt     DateTime           @default(now())
  sessions      Session[]
  workspaces    Workspace[]
  favorites     FavoritePrompt[]
  generated     GeneratedAsset[]
  prompts       PromptLibrary[]    @relation("SubmittedPrompts")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Workspace {
  id         String           @id @default(cuid())
  name       String
  ownerId    String
  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  blueprints AgentBlueprint[]
}

model AgentBlueprint {
  id                String          @id @default(cuid())
  workspaceId       String
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  taskDescription   String
  evalInputs        String          @default("[]")
  isPublic          Boolean         @default(false)
  createdAt         DateTime        @default(now())
  versions          AgentVersion[]
  conversations     Conversation[]
  apiKeys           ApiKey[]
}

model AgentVersion {
  id            String        @id @default(cuid())
  blueprintId   String
  blueprint     AgentBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  versionNumber Int
  systemPrompt  String
  model         String
  tools         String
  rubric        String
  guardrails    String
  status        String // ACTIVE | PENDING | REJECTED | SUPERSEDED
  changeSummary String?
  createdAt     DateTime      @default(now())
  evalRuns      EvalRun[]
  conversations Conversation[]

  @@unique([blueprintId, versionNumber])
}

model Conversation {
  id            String       @id @default(cuid())
  blueprintId   String
  blueprint     AgentBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  agentVersionId String
  agentVersion  AgentVersion @relation(fields: [agentVersionId], references: [id])
  title         String
  createdAt     DateTime     @default(now())
  messages      Message[]
  feedbacks     Feedback[]
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sequence       Int
  role           String // user | assistant | system
  content        String
  createdAt      DateTime    @default(now())

  @@unique([conversationId, sequence])
}

model Feedback {
  id             String      @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageSeq     Int
  rating         String // GOOD | BAD
  critique       String?
  createdAt      DateTime    @default(now())

  @@unique([conversationId, messageSeq])
}

model EvalRun {
  id             String     @id @default(cuid())
  agentVersionId String
  agentVersion   AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  status         String // RUNNING | COMPLETED | FAILED
  avgScore       Float      @default(0)
  passRate       Float      @default(0)
  createdAt      DateTime   @default(now())
  cases          EvalCase[]
}

model EvalCase {
  id               String  @id @default(cuid())
  evalRunId        String
  evalRun          EvalRun @relation(fields: [evalRunId], references: [id], onDelete: Cascade)
  input            String
  expectedBehavior String
  actualOutput     String
  score            Float
  verdict          String // PASS | FAIL
  notes            String
}

model ApiKey {
  id          String    @id @default(cuid())
  blueprintId String
  blueprint   AgentBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String    @unique
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}

//! TechRadar: tabla de inventario de tecnologias del proyecto (roadmap grafico).
//! Campos de lista (connections, improvements) se guardan como JSON-string porque
//! SQLite no soporta arrays escalares en Prisma.
model TechRadar {
  id           String   @id @default(cuid())
  name         String   @unique // ej: "Next.js", "Prisma"
  category     String // ej: "Framework", "Base de datos", "UI"
  usagePercent Float    @default(0) // porcentaje aproximado de uso en el codigo
  importance   Int      @default(3) // 1 (bajo) .. 5 (critico)
  connections  String   @default("[]") // JSON: ["otra-tech", ...]
  improvements String   @default("[]") // JSON: ["mejora sugerida", ...]
  status       String   @default("active") // active | planned | deprecated
  notes        String? // explicacion libre en español
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

//! Libreria de prompts de imagen/video (MeiGEN style). Seed desde
//! jau123/nanobanana-trending-prompts; los usuarios pueden aportar los propios.
model PromptLibrary {
  id              String             @id @default(cuid())
  slug            String             @unique
  prompt          String
  category        String // Portrait | Ads & Product | Poster | Illustration & 3D | UI Design | Video | Wallpaper | Branding | Custom
  tags            String             @default("[]") // JSON string[]
  models          String             @default("[]") // JSON string[] (gpt-image-2, nanobanana, midjourney...)
  aspectRatio     String             @default("1:1")
  imageUrl        String? // imagen de referencia / resultado
  sourceUrl       String? // post original (X/Twitter) o fuente
  engagementRank  Int                @default(0) // ranking por engagement (0 = sin ranking)
  isUserSubmitted Boolean            @default(false)
  submitter       User?              @relation("SubmittedPrompts", fields: [submitterId], references: [id], onDelete: SetNull)
  submitterId     String?
  useCount        Int                @default(0)
  createdAt       DateTime           @default(now())
  favorites       FavoritePrompt[]
}

model FavoritePrompt {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId  String
  prompt    PromptLibrary @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, promptId])
}

//! Historial de generaciones de imagen del usuario (galeria "Mis creaciones").
model GeneratedAsset {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt         String
  provider       String // pollinations | meigen | local | edge-tts | storyboard | composition
  model          String
  seed           Int?
  mediaType      String   @default("image") // image | audio | video | music | tts
  url            String
  width          Int      @default(1024)
  height         Int      @default(1024)
  sourcePromptId String? // si vino de "Usar idea" en la libreria
  createdAt      DateTime @default(now())
}
