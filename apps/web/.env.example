# --- Core AI provider (default: local Ollama, no key) ---
# ULTRAIA_PROVIDER: ollama | openai | google | deepseek
ULTRAIA_PROVIDER=ollama
ULTRAIA_MODEL=llama3.1

# OpenAI-compatible paid path (needs key) — switch ULTRAIA_PROVIDER=openai
OPENAI_API_KEY=

# Free Google AI (Gemini). Get a free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Free local models (Meta Llama, Microsoft Phi, Mistral) via Ollama.
# Install Ollama, `ollama pull llama3.1`, it serves an OpenAI-compatible API.
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Optional connectors (graceful when unset) ---
# Google Stitch (AI UI design): https://stitch.withgoogle.com  -> STITCH_API_KEY
STITCH_API_KEY=
# Google Flow / Veo (video) and Pomelli (branding) are used as deep-link +
# keyless storyboard/composer fallbacks; no key needed for the free path.

# --- Session secret (auth) ---
AUTH_SECRET=
