# UltraIa Web environment — Next.js reads this at build + runtime
# Full reference: root .env.example (123 lines)

# SQLite in dev; switch to Postgres URL in production
DATABASE_URL="file:./dev.db"

# Auth secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
AUTH_SECRET=

# LLM provider
ULTRAIA_PROVIDER=ollama
ULTRAIA_MODEL=llama3.1

# Keys (fill as needed — empty = keyless/fail-soft)
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_ENABLE_THINKING=false
QWEN_MODEL=qwen3.8-max-preview
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-2-9b-it:free
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
HUGGINGFACE_API_KEY=

# Local providers
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Public origin
APP_URL=http://localhost:3000

# Gen-Engine (empty = keyless fallback: Tunetank music + storyboard video)
GEN_ENGINE_URL=

# AutoPub channels (all optional: empty = fail-soft)
# Full guide: docs/CANALES-CONFIG-2026.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
YOUTUBE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
X_ACCESS_TOKEN=
IG_ACCESS_TOKEN=
IG_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
