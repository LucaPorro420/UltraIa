{
  "name": "ultraia",
  "displayName": "UltraIa — AI Product Development Suite",
  "description": "VS Code extension for the UltraIa monorepo: run gates, browse capabilities, manage the PIVR loop, and monitor project health.",
  "version": "1.0.0",
  "publisher": "ultraia",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Linters",
    "Testing"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ultraia.gateTypecheck",
        "title": "UltraIa: Run Typecheck"
      },
      {
        "command": "ultraia.gateLint",
        "title": "UltraIa: Run Lint"
      },
      {
        "command": "ultraia.gateTest",
        "title": "UltraIa: Run Tests"
      },
      {
        "command": "ultraia.gateBuild",
        "title": "UltraIa: Run Build"
      },
      {
        "command": "ultraia.gateAll",
        "title": "UltraIa: Run All Gates (typecheck → lint → test → build)"
      },
      {
        "command": "ultraia.projectStatus",
        "title": "UltraIa: Project Status"
      },
      {
        "command": "ultraia.openState",
        "title": "UltraIa: Open STATE.md"
      },
      {
        "command": "ultraia.openRunLog",
        "title": "UltraIa: Open loop-run-log.md"
      },
      {
        "command": "ultraia.openConstraints",
        "title": "UltraIa: Open loop-constraints.md"
      },
      {
        "command": "ultraia.browseCapabilities",
        "title": "UltraIa: Browse Capabilities"
      },
      {
        "command": "ultraia.searchTools",
        "title": "UltraIa: Search Tools"
      },
      {
        "command": "ultraia.openDashboard",
        "title": "UltraIa: Open Dashboard (localhost:3000)"
      },
      {
        "command": "ultraia.startDev",
        "title": "UltraIa: Start Dev Server"
      },
      {
        "command": "ultraia.stopDev",
        "title": "UltraIa: Stop Dev Server"
      },
      {
        "command": "ultraia.runStartPy",
        "title": "UltraIa: Run start.py (full stack)"
      },
      {
        "command": "ultraia.clearVitestCache",
        "title": "UltraIa: Clear Vitest Cache"
      },
      {
        "command": "ultraia.showRecentCommits",
        "title": "UltraIa: Show Recent Commits"
      },
      {
        "command": "ultraia.copyRepomix",
        "title": "UltraIa: Generate Repomix (LLM context)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ultraia",
          "title": "UltraIa",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "ultraia": [
        {
          "type": "webview",
          "id": "ultraia.dashboard",
          "name": "Dashboard"
        },
        {
          "type": "tree",
          "id": "ultraia.capabilities",
          "name": "Capabilities"
        },
        {
          "type": "tree",
          "id": "ultraia.gates",
          "name": "Gates"
        }
      ]
    },
    "configuration": {
      "title": "UltraIa",
      "properties": {
        "ultraia.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Path to Node.js executable"
        },
        "ultraia.pythonPath": {
          "type": "string",
          "default": "py -3.12",
          "description": "Path to Python 3.12 executable"
        },
        "ultraia.webPort": {
          "type": "number",
          "default": 3000,
          "description": "Dev server port"
        },
        "ultraia.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show UltraIa status bar item"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.136.0",
    "typescript": "^5.9.3"
  }
}
