      "physics": {
        "gravity": 240,
        "wind": -30,
        "friction": 0.98
      },
      "shaderGlsl": "vec3 meteor(vec2 uv, float t) { float trail = exp(-uv.y*7.0); float core = smoothstep(0.08, 0.0, length(uv - vec2(0.5, 0.9 - 0.8*t))); return vec3(1.0, 0.65, 0.35) * (trail*0.7 + core); }",
      "layers": [
