  "60s": [
    {
      "id": "60s-vfx-0",
      "kind": "fire",
      "name": "Pyro Blast",
      "palette": {
        "base": "#ff6b35",
        "accent": "#ffd166",
        "energy": "#ff2d2d"
      },
      "physics": {
        "gravity": -140,
        "wind": 18,
        "friction": 0.985
      },
      "shaderGlsl": "vec3 fire(vec2 uv, float t) { float d = length(uv - vec2(0.5, 0.1)); float n = sin(uv.x*28.0 - t*9.0)*0.5 + 0.5; float core = smoothstep(0.42, 0.0, d*(1.0 - 0.35*n)); return vec3(1.0, 0.42 + 0.35*n, 0.18) * core; }",
      "layers": [
        {
          "id": "core",
          "blend": "lighter",
          "opacity": 1
        },
        {
          "id": "smoke",
          "blend": "multiply",
