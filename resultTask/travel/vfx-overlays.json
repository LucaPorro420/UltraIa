        "gravity": -60,
        "wind": 6,
        "friction": 0.98
      },
      "shaderGlsl": "vec3 terra(vec2 uv, float t) { float ridge = abs(fract(uv.y*9.0 + sin(uv.x*14.0 + t)*0.5) - 0.5)*2.0; float surge = smoothstep(0.5, 0.0, length(uv - vec2(0.5, 0.05 + 0.3*ridge))); return vec3(0.84, 0.64, 0.33) * (surge*0.8 + 0.2); }",
      "layers": [
