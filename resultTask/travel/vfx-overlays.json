        "gravity": -4,
        "wind": -16,
        "friction": 0.99
      },
      "shaderGlsl": "vec3 frostFx(vec2 uv, float t) { float h = sin(uv.x*31.0 + t)*0.5 + sin(uv.y*47.0 + t*0.7)*0.5; float branch = smoothstep(0.42, 0.0, abs(h) - 0.08); return vec3(0.73, 0.9, 0.99)*branch; }",
      "layers": [
        {
          "id": "branch",
          "blend": "source-over",
          "opacity": 0.9
        },
