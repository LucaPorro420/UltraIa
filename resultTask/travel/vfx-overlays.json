    {
      "id": "60s-vfx-1",
      "kind": "lightning",
      "name": "Storm Arc",
      "palette": {
        "base": "#c4b5fd",
        "accent": "#ffffff",
        "energy": "#8b5cf6"
      },
      "physics": {
        "gravity": 60,
        "wind": 40,
        "friction": 0.95
      },
      "shaderGlsl": "vec3 bolt(vec2 uv, float t) { float seg = fract(sin(uv.x*97.0 + t*23.0)*43758.5); float y = abs(uv.y - 0.5 - (seg-0.5)*0.7); float w = 0.012 + 0.02*(1.0-uv.y); float b = smoothstep(w, 0.0, y); return vec3(0.98, 0.93, 1.0) * b * (0.6 + 0.4*sin(t*30.0)); }",
      "layers": [
        {
          "id": "arc",
          "blend": "lighter",
          "opacity": 1
        },
