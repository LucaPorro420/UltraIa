# UltraIa Travel Video Generator — Dockerfile
# Build: docker build -f Dockerfile.travel-video -t ultraia-travel .
# Run:  docker run --rm -v $(pwd)/resultTask/travel/output:/app/output ultraia-travel

FROM node:24-bookworm-slim AS base

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    python3 \
    python3-pip \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install edge-tts for narration
RUN pip3 install --no-cache-dir edge-tts

WORKDIR /app

# Copy package files for caching
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/runtime/package.json packages/runtime/
COPY apps/web/package.json apps/web/

# Install npm dependencies
RUN npm ci --workspaces --include-workspace-root 2>&1 | tail -20

# Copy source code
COPY . .

# Build TypeScript (core only needed for runtime)
RUN npm run build -w @ultraia/core 2>&1 | tail -10

# Make scripts executable
RUN chmod +x scripts/*.sh

# Default command: generate 30s, 60s, 2min videos
CMD ["bash", "scripts/generate-all-travel-videos.sh"]


# ============================================================================
# Alternative: Multi-stage for smaller final image (if only running scripts)
# ============================================================================
FROM base AS runner

# The scripts are self-contained bash + ffmpeg + edge-tts
# No Node runtime needed for execution, but kept for potential TS execution
ENTRYPOINT ["bash", "scripts/generate-all-travel-videos.sh"]