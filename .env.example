# UltraIa environment — copy to `.env` (root, for Prisma CLI) and `apps/web/.env` (for Next.js)

# SQLite in dev; switch to Postgres URL in production (e.g. postgresql://user:pass@host:5432/ultraia)
DATABASE_URL="file:./dev.db"

# LLM provider (OpenAI-compatible via la Vercel AI SDK). ULTRAIA_PROVIDER
# controla qué proveedor usa el gateway:
#   ollama    -> SIN KEY: modelo local (Llama/Phi/Mistral). Requiere Ollama
#                corriendo en http://localhost:11434 (OLLAMA_BASE_URL opcional).
#                Es el valor por defecto.
#   openai    -> necesita OPENAI_API_KEY
#   google    -> necesita GOOGLE_API_KEY (Gemini, tier gratuito)
#   deepseek  -> necesita DEEPSEEK_API_KEY (tier gratuito en platform.deepseek.com)
#   qwen      -> necesita DASHSCOPE_API_KEY (Alibaba, free tier, 1M ctx)
#   openrouter-> necesita OPENROUTER_API_KEY (UN solo key; incluye la capa `:free` keyless)
#   groq      -> necesita GROQ_API_KEY (free tier, latencia ultra-baja)
#   mistral   -> necesita MISTRAL_API_KEY (free tier)
#   together  -> necesita TOGETHER_API_KEY (free tier)
#   huggingface -> necesita HUGGINGFACE_API_KEY (free tier)
# El orquestador (ai/orchestrator.ts) conmuta entre estos automaticamente con failover.
ULTRAIA_PROVIDER="ollama"

# Modelo por defecto (usado cuando un agente no fija el suyo).
# Ollama local: llama3.1, qwen2.5-coder, o los tuneados ultraia-* de ollama/
# (p. ej. ultraia-orquestador). Externos: gpt-4o-mini, gpt-5-mini, etc.
ULTRAIA_MODEL="llama3.1"

OPENAI_API_KEY=""

# Proveedores alternativos (gratuitos, requieren su key)
GOOGLE_API_KEY=""
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# Qwen (Alibaba DashScope) - OpenAI-compatible en /compatible-mode/v1
# ULTRAIA_PROVIDER="qwen" para usarlo. Modelo front-tier 2026: qwen3.8-max-preview
# (2.4T MoE, 1M contexto, vision+texto, thinking + tool calling).
DASHSCOPE_API_KEY=""
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
# "true" habilita thinking mode (razonamiento profundo) en Qwen
QWEN_ENABLE_THINKING="false"
# Modelo explicito (opcional): qwen3.8-max-preview | qwen3.7-max | qwen3-max | qwen-plus | qwen-turbo
QWEN_MODEL="qwen3.8-max-preview"

# OpenRouter (OpenAI-compatible; UN solo key desbloquea cientos de modelos, incl.
# la capa `:free` keyless: google/gemma-2-9b-it:free, llama-3.1-8b-instruct:free,
# qwen2.5-coder-7b-instruct:free, deepseek-r1-distill-llama-70b:free, etc.).
# ULTRAIA_PROVIDER="openrouter" para usarlo. Modelo por defecto:
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemma-2-9b-it:free"

# Groq (OpenAI-compatible, free tier, latencia ultra-baja) — console.groq.com/keys
GROQ_API_KEY=""
# Mistral (OpenAI-compatible, free tier) — console.mistral.ai
MISTRAL_API_KEY=""
# Together AI (OpenAI-compatible, free tier) — api.together.xyz
TOGETHER_API_KEY=""
# HuggingFace Inference API (OpenAI-compatible, free tier) — huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=""

# Ollama (opcional, clave local sin API externa)
OLLAMA_BASE_URL="http://localhost:11434/v1"

# LM Studio (opcional, local sin API externa — OpenAI-compatible en :1234)
# ULTRAIA_PROVIDER="lmstudio" para usarlo
LMSTUDIO_BASE_URL="http://localhost:1234/v1"

# Public origin, used for links/redirects
APP_URL="http://localhost:3000"

# Gen-Engine self-hosted (gen-engine/, FastAPI). Sin valor = keyless
# (Tunetank música, storyboard video). start.py lanza el local en :8100 por
# defecto (el webhook server usa :8000) y lo anuncia en apps/web/.env.
# Para un pod GPU remoto: GEN_ENGINE_URL="http://<pod>:8000"
GEN_ENGINE_URL=""

# --- AutoPub canales de publicación (todos OPCIONALES: sin valor = fail-soft) ---
# Guía paso a paso: docs/CANALES-CONFIG-2026.md. Tools: publish_submit (8 plataformas).
# YouTube Shorts (resumable upload v3; OAuth2 del canal propio, scopes
# youtube.upload + youtube.force-ssl): YOUTUBE_ACCESS_TOKEN=""
# TikTok (Content Posting API; Direct Post 2 pasos; crear app en
# developers.tiktok.com + tokens de la app): TIKTOK_ACCESS_TOKEN=""
# X (API v2; OAuth2 user context — media upload + tweet):
X_ACCESS_TOKEN=""
# Instagram Reels / Threads (Graph API v21/v1.0; tokens de largo plazo del
# negocio propio — sin app review para negocio propio, verificado 2026):
IG_ACCESS_TOKEN=""
IG_USER_ID=""
THREADS_ACCESS_TOKEN=""
THREADS_USER_ID=""
# Telegram (Bot API — 100% GRATIS, sin tarjeta; crear bot con @BotFather):
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Discord (webhook del canal — gratis; Ajustes > Integraciones > Webhooks):
DISCORD_WEBHOOK_URL=""
# Slack (bot app — gratis; api.slack.com/apps > OAuth & Permissions > tokens xoxb-):
SLACK_BOT_TOKEN=""
SLACK_CHANNEL=""
# Facebook (Graph API v21; token de page + page id; negocio propio, sin app review):
FB_ACCESS_TOKEN=""
FB_PAGE_ID=""
# LinkedIn (Share API v2; token de usuario OAuth2 con scope w_member_social + URN de author):
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_AUTHOR_URN=""
# Reddit (oauth.reddit.com/api/submit; app de tipo "script" en reddit.com/prefs/apps):
REDDIT_ACCESS_TOKEN=""
REDDIT_SUBREDDIT=""
# Pinterest (API v5; token de access + board_id; developers.pinterest.com):
PINTEREST_ACCESS_TOKEN=""
PINTEREST_BOARD_ID=""
# WhatsApp Business Cloud API (graph.facebook.com/v21.0/{phone_id}/messages;
# token de sistema + phone number id + numero destinatario):
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TO=""

# --- Studio OSS integrations (loop-106/107, todas OPCIONALES: sin valor = fail-soft) ---
# Firecrawl agentic search (free tier; firecrawl.dev) → research_search accion 'firecrawl':
FIRECRAWL_API_KEY=""
# WebHarvest scraper local (100% offline): instalar con `pip install webharvest`
# (sin env; el WebPanel motor "Local (OSS)" lo detecta solo).
# Capturas reales de web (WebPanel → Captura): requieren Chromium de Playwright:
#   npx playwright install chromium
