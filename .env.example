# UltraIa environment — copy to `.env` (root, for Prisma CLI) and `apps/web/.env` (for Next.js)

# SQLite in dev; switch to Postgres URL in production (e.g. postgresql://user:pass@host:5432/ultraia)
DATABASE_URL="file:./dev.db"

# LLM provider (OpenAI-compatible via the Vercel AI SDK). ULTRAIA_PROVIDER
# controla qué proveedor usa el gateway:
#   ollama  -> SIN KEY: modelo local (Llama/Phi/Mistral). Requiere Ollama
#              corriendo en http://localhost:11434 (OLLAMA_BASE_URL opcional).
#              Es el valor por defecto.
#   openai  -> necesita OPENAI_API_KEY
#   google  -> necesita GOOGLE_API_KEY (Gemini, tier gratuito)
#   deepseek-> necesita DEEPSEEK_API_KEY (tier gratuito en platform.deepseek.com)
ULTRAIA_PROVIDER="ollama"

# Modelo por defecto (usado cuando un agente no fija el suyo).
# Ollama local: llama3.1, qwen2.5-coder, o los tuneados ultraia-* de ollama/
# (p. ej. ultraia-orquestador). Externos: gpt-4o-mini, gpt-5-mini, etc.
ULTRAIA_MODEL="llama3.1"

OPENAI_API_KEY=""

# Proveedores alternativos (gratuitos, requieren su key)
GOOGLE_API_KEY=""
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# Ollama (opcional, clave local sin API externa)
OLLAMA_BASE_URL="http://localhost:11434/v1"

# LM Studio (opcional, local sin API externa — OpenAI-compatible en :1234)
# ULTRAIA_PROVIDER="lmstudio" para usarlo
LMSTUDIO_BASE_URL="http://localhost:1234/v1"

# Public origin, used for links/redirects
APP_URL="http://localhost:3000"

# Gen-Engine self-hosted (gen-engine/, FastAPI). Sin valor = keyless
# (Tunetank música, storyboard video). start.py lanza el local en :8100 por
# defecto (el webhook server usa :8000) y lo anuncia en apps/web/.env.
# Para un pod GPU remoto: GEN_ENGINE_URL="http://<pod>:8000"
GEN_ENGINE_URL=""

# --- AutoPub canales de publicación (todos OPCIONALES: sin valor = fail-soft) ---
# Guía paso a paso: docs/CANALES-CONFIG-2026.md. Tools: publish_submit (8 plataformas).
# YouTube Shorts (resumable upload v3; OAuth2 del canal propio, scopes
# youtube.upload + youtube.force-ssl): YOUTUBE_ACCESS_TOKEN=""
# TikTok (Content Posting API; Direct Post 2 pasos; crear app en
# developers.tiktok.com + tokens de la app): TIKTOK_ACCESS_TOKEN=""
# X (API v2; OAuth2 user context — media upload + tweet):
X_ACCESS_TOKEN=""
# Instagram Reels / Threads (Graph API v21/v1.0; tokens de largo plazo del
# negocio propio — sin app review para negocio propio, verificado 2026):
IG_ACCESS_TOKEN=""
IG_USER_ID=""
THREADS_ACCESS_TOKEN=""
THREADS_USER_ID=""
# Telegram (Bot API — 100% GRATIS, sin tarjeta; crear bot con @BotFather):
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Discord (webhook del canal — gratis; Ajustes > Integraciones > Webhooks):
DISCORD_WEBHOOK_URL=""
# Slack (bot app — gratis; api.slack.com/apps > OAuth & Permissions > tokens xoxb-):
SLACK_BOT_TOKEN=""
SLACK_CHANNEL=""
