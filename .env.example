# UltraIa environment — copy to `.env` (root, for Prisma CLI) and `apps/web/.env` (for Next.js)

# SQLite in dev; switch to Postgres URL in production (e.g. postgresql://user:pass@host:5432/ultraia)
DATABASE_URL="file:./dev.db"

# LLM provider (OpenAI-compatible by default via the Vercel AI SDK)
OPENAI_API_KEY=""

# Default model used for blueprint generation, judging and agents when a blueprint
# does not pin its own model. Examples: gpt-4o-mini, gpt-4.1-mini, gpt-5-mini, claude-3-5-haiku
ULTRAIA_MODEL="gpt-4o-mini"

# Public origin, used for links/redirects
APP_URL="http://localhost:3000"
